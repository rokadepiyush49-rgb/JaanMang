# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ---- JanMaang: secrets and generated config ----
# Firebase project config is generated per-environment by `flutterfire configure`.
# It is kept out of git so a fork cannot accidentally point at production.
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist

# Server-side credentials. These must never reach the repository — the Gemini
# key and any service account live in Secret Manager, injected at runtime.
*serviceAccount*.json
firebase/functions/.env
firebase/functions/.env.*
# The template carries names and defaults only — never a value worth hiding.
!firebase/functions/.env.example
firebase/functions/lib/
firebase/functions/node_modules/

# The assistant API. Same rule: the template is committed, nothing else is.
server/node_modules/
server/.vercel/
server/.env
server/.env.*
!server/.env.example
.firebaserc
.env
.env.*
!.env.example

# Signing
android/key.properties
*.jks
*.keystore
