# JanMaang — client configuration template.
#
# Flutter has no runtime .env: the app is configured at compile time with
# --dart-define, and it deliberately holds no keys. This file is the list of
# names, so the same values can live in a CI secret store or a launch config.
#
# Nothing below is a credential. Every secret — Gemini, ElevenLabs, the ConvAI
# webhook secret — lives in Secret Manager and is read only by Cloud Functions.
# See firebase/functions/.env.example for those.
#
# Usage:
#   flutter run --dart-define=ENABLE_ELEVEN_CONVAI=true \
#               --dart-define=ELEVEN_AGENT_ID=agent_xxxxxxxx

# ---------------------------------------------------------------------------
# The assistant API
#
# Origin of the deployment that holds the Gemini key, e.g.
# https://janmaang-api.vercel.app. See server/.env.example for its own config.
#
# Leave empty and the assistant runs against the in-memory implementation
# instead: the whole flow, including the confirmation gate, works with no keys
# and no network.
# ---------------------------------------------------------------------------
ASSISTANT_API_BASE_URL=

# Run against live Firebase instead of the in-memory fixtures.
USE_MOCKS=true

# Google Maps surfaces, once a platform API key is in the native manifests.
MAPS_ENABLED=false

# Start the mock build already signed in, for demos and screenshots.
DEMO_SIGNED_IN=false

# ---------------------------------------------------------------------------
# ElevenLabs ConvAI real-time voice demo (optional)
#
# An enhancement on top of the assistant, not the assistant itself. With this
# off — the default — the text chatbot and its browser voice input and output
# work exactly as they otherwise would.
# ---------------------------------------------------------------------------
ENABLE_ELEVEN_CONVAI=false

# The agent id from the ElevenLabs dashboard, e.g. agent_01abc23def.
# Public by design (it identifies a widget, it does not authorise anything),
# but never hardcoded — an unset id simply hides the ConvAI entry point.
ELEVEN_AGENT_ID=
