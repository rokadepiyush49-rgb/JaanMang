# ===========================================================================
# Jan Setu — the single place every credential lives.
# ===========================================================================
#
#   cp .env.example .env        # .env is gitignored; never commit it
#   <fill in what you have>     # everything may stay blank — see below
#   node scripts/sync-env.mjs   # fans these out to backend/ and apps/web/
#
# Three processes need configuration — the NestJS API, the Next.js web app and
# the Flutter client — and several values (GROQ_API_KEY most of all) are needed
# by more than one of them. Keeping three templates in sync by hand is how one
# of them ends up a month stale, so this file is the source and `sync-env.mjs`
# writes the rest.
#
# BLANK IS A VALID ANSWER. Every optional integration below degrades to a real
# working path rather than to an error: no Groq key means report intake uses
# its deterministic keyword pass, no R2 means uploads go to local disk, no
# recommender URL means the heuristic scorer runs. A fresh clone with this file
# untouched still runs the whole product end to end. Fill these in when you
# want the hosted versions, not to get started.
#
# sync-env.mjs never clobbers: a value you leave blank here leaves whatever is
# already in backend/.env or apps/web/.env.local alone. Run it with --dry-run
# to see what it would change first.

# ---------------------------------------------------------------------------
# Database — Neon (https://neon.tech, free tier, no card)
#
# Blank locally: backend/.env already points at your local Postgres and sync
# will not overwrite it. Fill these in for the deployed API.
#   DATABASE_URL  the POOLED connection string (the "-pooler" host)
#   DIRECT_URL    the direct one — `prisma migrate` will not use a pooler
# ---------------------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=

# ---------------------------------------------------------------------------
# Auth secrets
#
# 32+ characters each, and different from each other. Generate a pair with:
#   node -e "for(const k of ['ACCESS','REFRESH'])console.log(`JWT_${k}_SECRET=`+require('crypto').randomBytes(48).toString('base64url'))"
#
# The values in backend/.env today are the committed dev placeholders. They are
# fine on your machine and must not reach a deployment — stage 08 rotates them.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---------------------------------------------------------------------------
# Groq — used by BOTH the web AI council and backend report intake.
#
# Free, no card: https://console.groq.com/keys
#
# Without it: /council/session answers 503 and says so, and report intake falls
# back to its keyword pass. The intake fallback is a real implementation, not a
# stub — clustering, priority and every downstream screen work without this key.
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# Optional model pins. Groq retires model ids without notice and a retired id
# 404s on every call, so check https://api.groq.com/openai/v1/models before
# setting these. Blank uses the defaults documented in apps/web/.env.example.
GROQ_MODEL=
GROQ_DEBATE_MODEL=

# ---------------------------------------------------------------------------
# Object storage — Cloudflare R2, S3-compatible. Read from stage 06.
#
# Free tier, no egress charge: https://dash.cloudflare.com → R2 → Manage API
# tokens. You need an account id, an access key pair, a bucket, and the public
# base URL if the bucket serves reads directly.
#
# Without these: uploads are written to backend/.uploads on local disk and
# served by the API, so evidence photos, before/after pairs and verification
# work end to end on your machine with no account anywhere. Production refuses
# to start on the local driver — blank config there is a misconfiguration, not
# a choice.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Deployment origins — set at stage 08, blank until then.
#
# CORS_ORIGINS is the one that bites: the API refuses a browser request from an
# origin not on this list, and the failure surfaces as sign-in silently
# spinning rather than as an error. It must carry the Vercel domain.
# ---------------------------------------------------------------------------
CORS_ORIGINS=
PUBLIC_API_URL=
BACKEND_API_URL=

# ---------------------------------------------------------------------------
# Optional integrations. All blank, all degrade to a working path.
# ---------------------------------------------------------------------------

# Google AI Studio, free, no GCP billing: https://aistudio.google.com/apikey
# An alternative intake model. Unused while GROQ_API_KEY is set.
GEMINI_API_KEY=

# Firebase Cloud Messaging admin credentials, as one line of JSON. Push
# notifications are skipped when absent; in-app notifications still work.
FCM_SERVICE_ACCOUNT_JSON=

# The external skill-map model, once it exists (stage 05). Blank runs the
# deterministic heuristic recommender, which is a genuine implementation and
# the fallback whenever the model is unreachable.
# RECOMMENDER_URL=

# ---------------------------------------------------------------------------
# Flutter citizen app — compile-time, not runtime.
#
# The Flutter app has no .env: it reads --dart-define at build time and holds
# no keys by design. `sync-env.mjs` cannot write these; it prints the command
# line instead. Listed here so every knob in the repository has one home.
#
#   USE_MOCKS       true runs against in-memory fixtures, no Firebase
#   MAPS_ENABLED    needs a platform API key in the native manifests first
#   DEMO_SIGNED_IN  start the mock build already signed in, for screenshots
# ---------------------------------------------------------------------------
FLUTTER_USE_MOCKS=true
FLUTTER_MAPS_ENABLED=false
FLUTTER_DEMO_SIGNED_IN=false
