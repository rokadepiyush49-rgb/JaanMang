# Jan Setu backend — the production variable set.
#
# This is the deploy-time companion to `.env.example` (which documents every
# knob for local work). Listed here is only what a production service actually
# needs set, split into what breaks the boot if missing and what degrades a
# feature if missing.
#
# Required values are enforced by `src/config/env.schema.ts` at startup: the
# process exits with a readable list rather than failing inside a request later.

# ===========================================================================
# REQUIRED — the service will not boot without these
# ===========================================================================

# Neon pooled connection string (the "-pooler" host), with sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/jansetu?sslmode=require

# Neon direct (non-pooled) host. `prisma migrate deploy` needs a session
# connection and will hang or fail against the pooler.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/jansetu?sslmode=require

# 32+ characters each, and DIFFERENT from one another. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Never reuse the dev placeholders from `.env.example` — they are public.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ===========================================================================
# REQUIRED IN PRACTICE — defaults exist but are wrong for production
# ===========================================================================

NODE_ENV=production
LOG_LEVEL=info

# The browser origins allowed to call this API. The web app is the only one:
# the Flutter client is not a browser and needs no entry. A wrong value here is
# the most common cause of "it works locally, the deployed site can't sign in".
CORS_ORIGINS=https://your-app.vercel.app

# Where this API is reachable. Used to build absolute links in OpenAPI and in
# email templates, so a stale value sends people to localhost.
PUBLIC_API_URL=https://your-backend.up.railway.app

# PORT is injected by the platform. Do not set it on Railway or Render.
# PORT=4000

# OTP codes are echoed into the log when this is true. That is a credential in
# your log aggregator — it must stay false outside development.
OTP_DEV_ECHO=false

# ===========================================================================
# OPTIONAL — each module checks at point of use and degrades without these
# ===========================================================================

# Object storage for attachments and verification evidence (Cloudflare R2).
#
# `auto` uses R2 when all four R2_* values below are present and falls back to
# local disk otherwise. In production that fallback is REFUSED with a 503 rather
# than taken: a container filesystem is ephemeral, so evidence written to disk
# disappears on the next restart, silently. Absent R2, the upload endpoints are
# unavailable and nothing else is affected.
STORAGE_DRIVER=auto
UPLOAD_MAX_BYTES=10485760
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Student opportunity matching. Absent: the weighted heuristic scorer runs.
# A URL that is set but unreachable falls back to the same scorer rather than
# failing the request — so a typo here degrades silently. Check the logs.
RECOMMENDER_URL=
RECOMMENDER_TIMEOUT_MS=2500

# AI report intake. Absent: intake falls back to a keyword pass.
GROQ_API_KEY=
GEMINI_API_KEY=

# Push notifications. Absent: notifications are stored but not delivered.
FCM_SERVICE_ACCOUNT_JSON=
