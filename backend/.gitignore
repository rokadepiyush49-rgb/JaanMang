# dependencies
/node_modules

# build
/dist
/build

# prisma
/prisma/*.db

# env — the *.example templates are committed, nothing else is.
# `.env.production.example` needed the second negation: `.env.*` swallowed it,
# so the file existed on every laptop, was linked from docs/DEPLOY.md, and had
# never been in a single commit.
.env
.env.*
!.env.example
!.env.*.example

# test / coverage
/coverage
*.tsbuildinfo

# generated openapi is committed; local scratch is not
/openapi.local.json

# editor
.DS_Store
.idea
*.log

# local npm cache override (machine-specific)
.npmrc
