// ===========================================================================
// Identity profiles — one table per audience
// ===========================================================================
//
// `Officer` and `Faculty` already establish the pattern: a 1:1 table keyed on
// userId that carries what *that* audience's screens need and nothing else.
// The three tables below complete it for students, government bodies and
// industry partners.
//
// Nothing here duplicates `User`. Name, email, phone, password and photo live
// on `User` because every audience has them; everything below exists because a
// specific screen reads it.

/// A student's profile. Every field is read by a student screen:
/// institution + branch + year drive team search and `TeamMember`; state and
/// district drive the opportunity and challenge region filters; skills drive
/// the match percentage on every opportunity card.
///
/// Deliberately absent: date of birth (no consumer, and students are often
/// minors), semester (`currentYear` is the granularity every consumer uses)
/// and any social link that no screen renders yet.
model StudentProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The institution as a platform organisation, when it is already on the
  /// register. Null for a college a student typed in themselves.
  orgId           String?
  org             Organization? @relation(fields: [orgId], references: [id])
  /// Always set — the display string, whether or not `orgId` resolved.
  institutionName String

  degree         String
  branch         String
  currentYear    Int
  graduationYear Int
  /// Only ever used as evidence when an institution verifies the student.
  enrollmentNo   String?

  state    String
  district String

  skills    String[]
  interests String[]

  // -------------------------------------------------------------------------
  // Recommender inputs
  //
  // Everything the skill-map recommender reads, held as columns rather than
  // derived per request. `RecommendationService` documents the feature vector
  // these become; an external model plugs in behind that same contract.
  // -------------------------------------------------------------------------

  /// Problem categories the student wants to work on. Empty means no
  /// preference, which the scorer reads as "all", not as "none".
  preferredCategories   ProblemCategory[]
  /// Districts the student can realistically reach. Empty means no constraint.
  preferredDistricts    String[]
  /// SDG numbers, 1–17. Matches Problem.sdgGoals.
  sdgInterests          Int[]
  /// Hours a week the student says they can give. Null = unstated, which the
  /// scorer must not read as zero.
  weeklyHours           Int?
  /// Contributions that reached a confirmed Verification. Maintained by the
  /// recognition cron, never written by the client — a student cannot assert
  /// their own track record.
  verifiedContributions Int               @default(0)
  /// When the recommender last ran for this student, so a cron can prioritise
  /// stale rows over recomputing everybody.
  lastRecommendedAt     DateTime?

  /// Where the institution has placed this student in its own structure. Set
  /// by the institute roster screen, never by the student — a student cannot
  /// put themselves in a department they are not in.
  departmentId String?
  department   InstituteDepartment? @relation(fields: [departmentId], references: [id])
  programId    String?
  program      Program?             @relation(fields: [programId], references: [id])

  /// The institution confirming this person is really enrolled. Until it is
  /// set the student is on the roster as *claimed*, and the institute screen
  /// shows them in a queue rather than in the roll.
  verifiedAt   DateTime?
  verifiedById String?

  /// Collected later from the profile screen, never at signup.
  resumeUrl    String?
  githubUrl    String?
  linkedinUrl  String?
  portfolioUrl String?

  /// Set when the onboarding wizard completes. Null = still onboarding.
  onboardedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([departmentId])
  @@map("student_profiles")
}

enum GovBodyType {
  gram_panchayat
  nagar_panchayat
  municipal_council
  municipal_corporation
  block_office
  district_office
  line_department
  other
}

/// A government authority, as distinct from the person who signs in for it.
///
/// `lgdCode` is the Local Government Directory identifier the platform already
/// names as its government key (see the citizen app's method page). It is
/// optional on purpose: the product publicly states that every geographic unit
/// currently carries a null LGD code, so requiring one would make signup
/// impossible for exactly the bodies it is meant to serve.
model GovernmentBodyProfile {
  orgId String       @id
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  bodyType GovBodyType
  lgdCode  String?     @unique

  state    String
  district String
  block    String?
  bodyName String

  officeAddress String?
  pincode       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, district])
  @@map("government_body_profiles")
}

enum OrgSize {
  startup
  sme
  enterprise
  mnc
  psu
  csr_trust
  other
}

/// An industry partner's matchable profile.
///
/// Every array here is an input to `apps/web/src/lib/industry/match.ts`:
/// csrThemes 25 points, technologyDomains 25, geographies 20, the funding
/// range 15, capabilities 15. They are columns rather than `Organization.profile`
/// Json precisely because the match engine filters on them.
model IndustryProfile {
  orgId String       @id
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  orgSize         OrgSize
  sector          String
  website         String?
  yearEstablished Int?
  employeeCount   Int?

  csrThemes         String[]
  geographies       String[]
  technologyDomains String[]
  capabilities      String[]
  sdgPreferences    Int[]
  provenDomains     String[]

  fundingMin Decimal @default(0) @db.Decimal(14, 2)
  fundingMax Decimal @default(0) @db.Decimal(14, 2)

  csrFinancialYear      String?
  csrAllocated          Decimal? @db.Decimal(14, 2)
  csrPreferredCeiling   Decimal? @db.Decimal(14, 2)
  /// CSR committed outside this platform — direct grants, employee
  /// volunteering, trust transfers.
  ///
  /// Modelled separately because the platform accounts only for its own share.
  /// A ledger that treated the whole budget as committed here would overstate
  /// what this portal delivered, and the company's finance team would be the
  /// first to notice.
  csrCommittedElsewhere Decimal  @default(0) @db.Decimal(14, 2)
  /// [{ domain, share }] — the board's per-domain split of the allocation, as
  /// shares of 100. The plan against which actual spend is reported.
  csrAllocation         Json     @default("[]")

  onboardedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("industry_profiles")
}

/// A university or college. Feeds `/industry/universities` and the institution
/// picker in student onboarding. Added now so the institution register exists
/// before the Institute surface does.
enum InstitutionType {
  university
  college
  polytechnic
  iti
  training_institute
  other
}

model InstitutionProfile {
  orgId String       @id
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  shortName     String
  city          String
  state         String
  district      String?
  accreditation String?
  aisheCode     String?
  focusAreas    String[]
  labs          String[]
  /// Domains that prove a student belongs here, e.g. ["bitmesra.ac.in"].
  emailDomains  String[]

  institutionType InstitutionType @default(college)
  website         String?
  officialEmail   String?
  officialPhone   String?
  establishedYear Int?
  logoUrl         String?

  /// Set when the institute wizard completes. Null = still onboarding, which
  /// is what `AuthService.isOnboarded` reads for this surface.
  onboardedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
  @@map("institution_profiles")
}

// ===========================================================================
// Academic structure
// ===========================================================================
//
// `Department` above is a *government line department* — it owns problem
// categories, carries a budget and routes citizen demand. An academic
// department shares nothing with it but the English word, so it is its own
// table. Merging them would give a Civil Engineering department an SLA and a
// crore of public money.

model InstituteDepartment {
  id    String       @id @default(uuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name String
  /// Short code the institution already uses internally, e.g. "CSE".
  code String

  /// Head of department — a faculty member of the same institution. Not a
  /// relation to `Faculty` because that would make the two tables mutually
  /// required; the API validates it.
  hodFacultyId String?

  /// Declared teaching strength. Faculty *rows* are counted live; this is the
  /// establishment figure, which is a different and also useful number.
  facultyStrength Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  programs Program[]
  faculty  Faculty[]
  students StudentProfile[]
  teams    StudentTeam[]

  @@unique([orgId, code])
  @@index([orgId])
  @@map("institute_departments")
}

enum ProgramLevel {
  certificate
  diploma
  undergraduate
  postgraduate
  doctoral
}

enum ProgramStatus {
  active
  paused
  archived
}

model Program {
  id           String              @id @default(uuid())
  orgId        String
  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  departmentId String
  department   InstituteDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  name          String
  level         ProgramLevel
  durationYears Int
  /// Sanctioned seats per year. Enrolment is counted from the roster.
  intake        Int?
  eligibility   String?
  status        ProgramStatus @default(active)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  students StudentProfile[]

  @@index([orgId])
  @@index([departmentId])
  @@map("programs")
}

enum OrgLocationKind {
  headquarters
  branch
  plant
  office
}

/// Where an organisation physically is.
///
/// A branch is a *location* of one legal entity; a subsidiary is a different
/// entity and already has `Organization.parentOrgId`. Keeping them apart is
/// what lets the dashboard carry branch-wise jobs, contacts and analytics
/// without giving every branch its own users, verification and CSR budget.
model OrgLocation {
  id    String       @id @default(uuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  kind        OrgLocationKind @default(branch)
  label       String?
  addressLine String?
  state       String
  district    String?
  city        String
  pincode     String?
  lat         Float?
  lng         Float?
  isPrimary   Boolean         @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@map("org_locations")
}

/// Who a person is *inside* an organisation.
///
/// `UserRole(orgId)` already answers what they may do. This answers who they
/// are — designation, official contact, whether they are the contact the
/// platform writes to. Splitting the two is what makes
/// organisation → representative → login account three things rather than one,
/// and what lets a second CSR officer be invited later with no new signup flow.
model OrgMembership {
  id     String       @id @default(uuid())
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  designation      String
  officialEmail    String?
  officialPhone    String?
  isPrimaryContact Boolean @default(false)

  /// What this person can mentor on, if anything.
  ///
  /// Here rather than on the user, because it is a fact about their role in
  /// this organisation: the same person consulting for two companies offers
  /// different things under each. Empty means they are not offering mentoring,
  /// which is the default and not a gap.
  mentorRoles         String[]
  mentorHoursPerMonth Int?
  /// Languages they can hold a design review in. In this district that is the
  /// difference between a mentor a team can use and one they cannot.
  languages           String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, orgId])
  @@index([orgId])
  @@map("org_memberships")
}

enum VerificationSubject {
  user
  organization
}

enum VerificationStatus {
  pending
  verified
  rejected
  info_requested
}

/// The review record for an account that claims authority.
///
/// Government and industry accounts hold power over other people's money and
/// other people's data, so the role they ask for is recorded as a *request*
/// and granted by a reviewer. `signals` holds what the server could check by
/// itself (email domain class, website/email domain match, duplicate bodies),
/// so a reviewer reads evidence rather than guessing.
model AccountVerification {
  id String @id @default(uuid())

  subjectType VerificationSubject
  subjectId   String
  status      VerificationStatus  @default(pending)

  /// The role key the applicant asked for. Granted, downgraded or refused.
  requestedRoleKey String?
  /// Jurisdiction the applicant claims, for a government body.
  jurisdictionId   String?

  submittedById String?
  submittedBy   User?   @relation("VerificationSubmittedBy", fields: [submittedById], references: [id])

  /// { emailDomainClass, websiteMatchesEmail, duplicateOrgIds, … }
  signals Json @default("{}")

  reviewedById String?
  reviewedBy   User?     @relation("VerificationReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([subjectType, subjectId])
  @@map("account_verifications")
}

/// A request whose effect must happen at most once, however many times the
/// client sends it.
///
/// The web app's proxy already forwards an `Idempotency-Key` header and nothing
/// consumed it, so a double-tapped submit on a flaky connection filed two
/// reports — and, from stage 03, committed a department budget twice. The
/// interceptor stores the first response here and replays it verbatim.
///
/// `fingerprint` is a hash of the method, path and body. A client that reuses a
/// key for a *different* request has a bug, and quietly replaying the old
/// response would hide it, so that case is a 409 rather than a replay.
model IdempotencyRecord {
  id String @id @default(uuid())

  /// The caller: a user id, or "anonymous" for public intake, where the client
  /// generates the key and a collision between two strangers' UUIDs is not a
  /// risk worth a column. Not nullable, because Postgres treats NULLs as
  /// distinct and a unique index over one would enforce nothing.
  subject     String
  key         String
  fingerprint String

  method String
  path   String

  statusCode Int
  /// The response body as first returned, replayed byte-for-byte on a repeat.
  response   Json

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@unique([subject, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// ===========================================================================
// Participation — voting, proposals, hackathons
// ===========================================================================

/// One citizen, one problem, one vote.
///
/// Deliberately *not* the same signal as a CitizenReport. A report means "I
/// have this problem"; a vote means "I agree this matters", and the voter need
/// not be affected by it. The priority engine weights them differently, so they
/// stay two columns — `Problem.reportCount` and `Problem.voteCount` — all the
/// way through rather than being merged into one demand number on the way in.
model ProblemVote {
  id        String  @id @default(uuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, problemId])
  @@index([problemId])
  @@index([userId])
  @@map("problem_votes")
}

enum SolutionProposalStatus {
  draft
  submitted
  under_review
  accepted
  rejected
  withdrawn
}

/// An institution proposing a solution to a published problem unprompted,
/// rather than waiting for the matcher to pair it with one.
///
/// The inverse of `Application`: an Application answers a brief somebody else
/// wrote, a SolutionProposal writes the brief. Both end in the same place — a
/// StudentTeam working on a Problem — which is why this carries an optional
/// teamId rather than inventing a second team model.
model SolutionProposal {
  id        String       @id @default(uuid())
  problemId String
  problem   Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  teamId    String?
  team      StudentTeam? @relation(fields: [teamId], references: [id])

  title    String
  summary  String
  approach String

  estimatedCost Decimal  @default(0) @db.Decimal(14, 2)
  durationDays  Int?
  /// What the institution says it needs from government or a partner.
  needs         String[]

  status SolutionProposalStatus @default(draft)

  submittedById String?
  submittedAt   DateTime?
  reviewedById  String?
  reviewedAt    DateTime?
  /// Why it was accepted or refused. Shown to the proposing institution.
  decisionNote  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([problemId])
  @@index([orgId])
  @@index([teamId])
  @@index([status])
  @@map("solution_proposals")
}

enum HackathonStatus {
  draft
  announced
  registration_open
  in_progress
  judging
  completed
  cancelled
}

/// A time-boxed event binding a set of Problems to a set of StudentTeams.
///
/// Deliberately thin: teams are `StudentTeam`, entries are `Application`, and
/// judging writes `Award`. A hackathon is a window and a problem set, not a
/// parallel universe with its own teams and submissions.
model Hackathon {
  id        String        @id @default(uuid())
  code      String        @unique
  title     String
  about     String?
  hostOrgId String?
  hostOrg   Organization? @relation(fields: [hostOrgId], references: [id])

  status HackathonStatus @default(draft)
  mode   String?

  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  startsAt             DateTime
  endsAt               DateTime

  prizePool   Decimal @default(0) @db.Decimal(14, 2)
  maxTeamSize Int?
  venue       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  problems HackathonProblem[]
  teams    HackathonTeam[]

  @@index([status])
  @@index([hostOrgId])
  @@map("hackathons")
}

/// The problem set a hackathon puts in front of its teams.
model HackathonProblem {
  hackathonId String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  problemId   String
  problem     Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  /// The track or brief label this problem was presented under.
  track       String?

  createdAt DateTime @default(now())

  @@id([hackathonId, problemId])
  @@index([problemId])
  @@map("hackathon_problems")
}

/// A team's registration in a hackathon, and where it finished.
model HackathonTeam {
  hackathonId String
  hackathon   Hackathon   @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  teamId      String
  team        StudentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  registeredAt DateTime  @default(now())
  withdrawnAt  DateTime?
  /// Set at judging. Null until then.
  finalRank    Int?
  score        Float?

  @@id([hackathonId, teamId])
  @@index([teamId])
  @@map("hackathon_teams")
}

/// The industry-facing brief on a validated problem.
///
/// Deliberately a separate table from `Problem` rather than more columns on it.
/// A partner looking at P-1042 is looking at the very record an officer
/// validated — same reports, same people, same priority — and this adds only
/// the layer the government has no reason to hold: which technologies a
/// solution needs, which capability gap is the real obstacle, what success
/// would be defined as before anyone commits. Nothing here overrides a
/// government figure; it annotates one.
///
/// Its absence is meaningful too: a validated problem with no profile is one
/// nobody has written a partner-facing brief for yet, and the portal says so
/// rather than inventing a summary.
model ChallengeProfile {
  problemId String  @id
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  /// One paragraph written for a partner, not for an officer.
  summary String
  /// The industry domain this sits in — water, energy, mobility, …
  domain  String

  technologies       String[]
  capabilitiesNeeded String[]
  /// fund | build | mentor | equipment | training
  supportNeeded      String[]
  timelineDays       Int      @default(120)

  /// The government sanction order this was published under, when there is one.
  sanctionReference String?

  /// [{ label, target, measure }] — what success is, agreed before commitment.
  expectedOutcomes Json @default("[]")
  /// [{ label, value, source }] — evidence lines beyond the ones derived from
  /// the government record. No number appears on a partner screen without one.
  evidence         Json @default("[]")

  /// When the brief was opened to partners. Null = drafted, not published.
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([domain])
  @@map("challenge_profiles")
}

// ===========================================================================
// CSR benefit
// ===========================================================================

enum CsrDocumentationStatus {
  not_started
  drafted
  submitted
  certified
  filed
}

/// The tax position a sponsorship moves, attached 1:1 to the Sponsorship.
///
/// This is why a partner engages at all, so it is a table and not a Json blob:
/// the CSR report at the end of the financial year is a sum over these rows.
/// `csrSpendBefore` / `csrSpendAfter` record the partner's cumulative position
/// at the moment of commitment, so the report reconstructs the year without
/// re-deriving it from a moving balance.
model CsrBenefit {
  problemId   String      @id
  sponsorship Sponsorship @relation(fields: [problemId], references: [problemId], onDelete: Cascade)

  /// The Companies Act section claimed under — "135" for mainline CSR spend.
  qualifyingSection String  @default("135")
  /// The Schedule VII activity head, e.g. "(i) eradicating hunger".
  scheduleViiItem   String?
  financialYear     String

  estimatedRelief Decimal @default(0) @db.Decimal(14, 2)
  /// The partner's cumulative CSR spend before and after this commitment.
  csrSpendBefore  Decimal @default(0) @db.Decimal(14, 2)
  csrSpendAfter   Decimal @default(0) @db.Decimal(14, 2)

  documentation CsrDocumentationStatus @default(not_started)
  certificateNo String?
  certifiedAt   DateTime?
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([financialYear])
  @@map("csr_benefits")
}

// ===========================================================================
// Delivery rating
// ===========================================================================

/// A citizen's verdict on how well a completed project was delivered.
///
/// Distinct from `Verification` on purpose. Verification asks *was it fixed*
/// and is a yes or no with photographic evidence; rating asks *how well*, and
/// is the signal the delivery leaderboards in the recognition layer rank on.
/// Merging the two loses the second answer, which is the one that separates a
/// handpump that works from a handpump that works and was finished on time.
model DeliveryRating {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 1–5. Constrained in the service layer and by a check constraint added in
  /// the migration — Prisma has no native range type.
  stars   Int
  comment String?

  /// Sub-scores, all optional: a citizen may rate overall and nothing else.
  timeliness Int?
  quality    Int?
  conduct    Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("delivery_ratings")
}

// ===========================================================================
// Recognition — badges, awards, leaderboards
// ===========================================================================

enum BadgeTier {
  bronze
  silver
  gold
  platinum
}

/// The *definition* of a badge and the rule that earns it.
///
/// `criteria` is the machine-readable rule the recognition cron evaluates
/// (e.g. `{ "metric": "verifications_confirmed", "gte": 10 }`). Keeping the
/// rule in a row rather than in code means a new badge is a seed entry, and an
/// existing badge's threshold can be corrected without a deploy.
model Badge {
  id          String    @id @default(uuid())
  key         String    @unique
  name        String
  description String
  tier        BadgeTier @default(bronze)
  /// Which audience can hold it — a Surface, so it lines up with the shells.
  surface     Surface
  icon        String?
  points      Int       @default(0)
  criteria    Json      @default("{}")
  active      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  earned BadgeEarned[]

  @@index([surface])
  @@map("badges")
}

/// A badge actually held by a person, with the numbers that earned it.
///
/// `Achievement` remains the generic points-bearing accomplishment; this is
/// the narrower rule-earned kind, and it keeps `evidence` so a holder can see
/// which ten verifications got them the badge.
model BadgeEarned {
  id      String @id @default(uuid())
  badgeId String
  badge   Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The metric snapshot at the moment the rule fired.
  evidence Json     @default("{}")
  earnedAt DateTime @default(now())

  @@unique([badgeId, userId])
  @@index([userId])
  @@map("badges_earned")
}

enum AwardSubject {
  user
  organization
  team
}

/// A granted honour. Unlike a Badge, nothing computes this — a person decides.
///
/// Polymorphic on subject because an award goes to a citizen, an institution
/// or a team with equal ease, and three near-identical tables would be worse.
/// The same shape as LeaderboardEntry, for the same reason.
model Award {
  id          String  @id @default(uuid())
  key         String?
  name        String
  description String?
  /// Free text: "Best Delivery, Ranchi District, FY 2026".
  citation    String?
  period      String?

  subjectType AwardSubject
  subjectId   String

  grantedById String?
  grantedBy   User?     @relation("AwardGrantedBy", fields: [grantedById], references: [id])
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectType, subjectId])
  @@index([key])
  @@map("awards")
}

enum LeaderboardScope {
  citizens
  students
  institutes
  partners
  officers
}

enum LeaderboardSubject {
  user
  organization
  team
}

/// A materialised rank row, refreshed on a schedule.
///
/// Ranking is a window function over several tables; running it per request on
/// a public page is how a leaderboard takes a site down. This table is the
/// answer, recomputed by a cron. `breakdown` carries the components of the
/// score so a leaderboard can say *why* somebody is third, and `displayName`
/// is cached so rendering a page of fifty costs one query rather than fifty-one.
///
/// Scores come from verified outcomes only — see the recognition service. An
/// activity count would rank the loudest account first, which is the opposite
/// of what this is for.
model LeaderboardEntry {
  id          String             @id @default(uuid())
  scope       LeaderboardScope
  subjectType LeaderboardSubject
  subjectId   String

  displayName  String
  score        Float  @default(0)
  rank         Int
  /// Rank in the previous computation, so the UI can show movement.
  previousRank Int?
  /// { verifiedProblems: 12, avgRating: 4.4, fundsDelivered: "120000", … }
  breakdown    Json   @default("{}")

  /// Optional narrowing — a district leaderboard rather than a platform one.
  jurisdictionId String?
  /// The window the score covers: "all-time", "2026", "2026-Q3".
  period         String  @default("all-time")

  computedAt DateTime @default(now())

  @@unique([scope, subjectType, subjectId, period, jurisdictionId])
  @@index([scope, period, rank])
  @@index([subjectType, subjectId])
  @@map("leaderboard_entries")
}

// ===========================================================================
// Public statistics
// ===========================================================================

/// One year of platform-wide figures, for the public landing page.
///
/// Live counts (problems, reports, villages) are queried from their own tables.
/// This table holds the *historical series* — the years before the data in this
/// database — and every row carries its own provenance string, which the
/// landing page renders beside the figure. The platform's rule is that no
/// number appears without its source; a marketing page is not an exception.
model PlatformYearStat {
  year Int @id

  reportsSubmitted  Int
  problemsValidated Int
  problemsResolved  Int
  citizensVerifying Int
  villagesCovered   Int
  panchayatsOnboard Int
  studentsEngaged   Int
  partnerOrgs       Int
  /// Rupees moved through the public ledger that year.
  fundsRouted       Decimal @db.Decimal(16, 2)

  /// Rendered verbatim under the figures it explains.
  provenance String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_year_stats")
}
