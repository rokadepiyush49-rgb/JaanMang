// Jan Setu — database schema.
//
// Mirrors the domain model the web app already carries in
// apps/web/src/lib/gov/types.ts and apps/web/src/lib/industry/types.ts, plus the
// identity / RBAC tables the frontend never had. See the approved plan §6 for
// the ERD and the reasoning.
//
// Conventions
//   - String ids. New rows get a uuid; seeded rows keep the human ids the web
//     fixtures use ("P-1042", "gp-nagri", "dept-water") so existing web links
//     and the seed map 1:1.
//   - createdAt / updatedAt on every table.
//   - deletedAt (soft delete) on user-authored content.
//   - Enums mirror the string unions in the web types, snake_cased where the
//     web used snake_case already.
//   - Deep value-object arrays with no query need (AI interpretation lines, gov
//     project milestones, pilot telemetry) are Json; everything filtered,
//     sorted or joined is a column.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===========================================================================
// Identity & access
// ===========================================================================

enum UserKind {
  citizen
  staff
  admin
}

enum UserStatus {
  active
  suspended
  pending
}

enum Locale {
  en
  hi
}

/// Which workspace a role sends its holder to after sign-in.
///
/// The home surface is a property of the *role*, not of the user, so adding a
/// new audience later (institute, NGO, mentor) is a seeded row plus a route
/// group — never a change to the session, the guard or the token.
enum Surface {
  citizen
  student
  gov
  industry
  institute
  admin
}

model User {
  id              String     @id @default(uuid())
  kind            UserKind
  status          UserStatus @default(active)
  displayName     String
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String?
  photoUrl        String?
  locale          Locale     @default(en)
  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roles              UserRole[]
  refreshTokens      RefreshToken[]
  passwordResets     PasswordResetToken[]
  officer            Officer?
  faculty            Faculty?
  studentProfile     StudentProfile?
  orgMemberships     OrgMembership[]
  verificationsFiled AccountVerification[] @relation("VerificationSubmittedBy")
  verificationsRead  AccountVerification[] @relation("VerificationReviewedBy")
  teamMemberships    TeamMember[]
  reports            CitizenReport[]
  auditEntries       AuditEntry[]
  notifications      Notification[]
  attachments        Attachment[]
  rankingObjections  RankingObjection[]
  verifications      Verification[]
  impactPoints       ImpactPointsEntry[]
  achievements       Achievement[]
  weightSetsCreated  PriorityWeightSet[]
  fundingApprovals   Funding[]             @relation("FundingApprovedBy")
  allocationsApprved Allocation[]          @relation("AllocationApprovedBy")
  problemVotes       ProblemVote[]
  deliveryRatings    DeliveryRating[]
  badgesEarned       BadgeEarned[]
  awardsGranted      Award[]               @relation("AwardGrantedBy")

  @@index([kind])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum OtpPurpose {
  login
  phone_verify
  password_reset
}

model OtpCode {
  id         String     @id @default(uuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
  @@map("otp_codes")
}

/// A single-use email password-reset token. Hashed at rest; in development the
/// raw token is returned in the response so the flow works without an email
/// provider wired up.
model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Roles are a closed set; see prisma/seed/rbac.ts. A user holds a role
/// optionally scoped to one organisation (an officer in a department, a student
/// in an institution).
model Role {
  id          String           @id @default(uuid())
  key         String           @unique
  label       String
  /// Where a holder of this role lands after sign-in.
  surface     Surface          @default(citizen)
  /// Breaks the tie when a user holds several roles — highest rank wins.
  rank        Int              @default(0)
  permissions RolePermission[]
  users       UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid())
  key   String           @unique
  label String
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// A role a user holds, optionally scoped. `orgId` scopes it to one
/// organisation (an industry user, a student in an institution); `jurisdictionId`
/// scopes it to a point in the administrative tree (a panchayat secretary, a
/// BDO, a DC). Both null = a platform-wide role (admin).
model UserRole {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  orgId          String?
  org            Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  jurisdictionId String?
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, roleId, orgId, jurisdictionId])
  @@index([userId])
  @@map("user_roles")
}

// ===========================================================================
// Geography
// ===========================================================================

enum GovLevel {
  state
  district
  block
  panchayat
  /// Urban local body — nagar panchayat, municipal council, municipal
  /// corporation. Sits under a district (corporations) or a block (the rest),
  /// so the existing parent/child scoping needs no special case.
  ulb
}

model Jurisdiction {
  id         String         @id @default(uuid())
  level      GovLevel
  name       String
  parentId   String?
  parent     Jurisdiction?  @relation("JurisdictionTree", fields: [parentId], references: [id])
  children   Jurisdiction[] @relation("JurisdictionTree")
  population Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  villages      Village[]
  problems      Problem[]
  organizations Organization[]
  officers      Officer[]
  weightSets    PriorityWeightSet[]
  userRoles     UserRole[]

  @@index([parentId])
  @@map("jurisdictions")
}

model Village {
  id             String       @id @default(uuid())
  name           String
  jurisdictionId String
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id])
  population     Int
  /// SECC multidimensional deprivation, 0 (well served) → 1 (most deprived).
  deprivation    Float
  lat            Float
  lng            Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problems ProblemVillage[]
  reports  CitizenReport[]

  @@index([jurisdictionId])
  @@map("villages")
}

// ===========================================================================
// Organizations
// ===========================================================================

enum OrgType {
  institution
  government_body
  industry
  department
}

model Organization {
  id             String         @id @default(uuid())
  type           OrgType
  name           String
  legalName      String?
  sector         String?
  about          String?
  jurisdictionId String?
  jurisdiction   Jurisdiction?  @relation(fields: [jurisdictionId], references: [id])
  parentOrgId    String?
  parentOrg      Organization?  @relation("OrgTree", fields: [parentOrgId], references: [id])
  childOrgs      Organization[] @relation("OrgTree")
  /// Type-specific profile (CSR budget, accreditation, labs, …). Shape depends
  /// on `type`; the API layer narrows it.
  profile        Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  department       Department?
  sponsor          Sponsor?
  govBody          GovernmentBodyProfile?
  industryInfo     IndustryProfile?
  institution      InstitutionProfile?
  locations        OrgLocation[]
  memberships      OrgMembership[]
  students         StudentProfile[]
  userRoles        UserRole[]
  studentTeams     StudentTeam[]
  faculty          Faculty[]
  fundingCommits   FundingCommitment[]
  departments      InstituteDepartment[]
  programs         Program[]
  proposals        SolutionProposal[]
  hackathonsHosted Hackathon[]

  @@index([type])
  @@map("organizations")
}

model Department {
  id              String            @id @default(uuid())
  orgId           String?           @unique
  org             Organization?     @relation(fields: [orgId], references: [id])
  name            String
  shortName       String
  /// Problem categories this department owns — the basis of automatic routing.
  categories      ProblemCategory[]
  headOfficerId   String?
  budgetAllocated Decimal           @db.Decimal(14, 2)
  budgetCommitted Decimal           @db.Decimal(14, 2)
  budgetSpent     Decimal           @db.Decimal(14, 2)
  slaHours        Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  officers Officer[]
  problems Problem[]

  @@map("departments")
}

model Officer {
  userId            String       @id
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId      String
  department        Department   @relation(fields: [departmentId], references: [id])
  jurisdictionId    String
  jurisdiction      Jurisdiction @relation(fields: [jurisdictionId], references: [id])
  designation       String
  phone             String
  capacity          Int
  activeTasks       Int          @default(0)
  criticalTasks     Int          @default(0)
  overdue           Int          @default(0)
  completionRate    Float        @default(0)
  avgResolutionDays Float        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedProblems Problem[] @relation("ProblemAssignedOfficer")

  @@index([departmentId])
  @@index([jurisdictionId])
  @@map("officers")
}

model Sponsor {
  id                 String        @id @default(uuid())
  orgId              String?       @unique
  org                Organization? @relation(fields: [orgId], references: [id])
  name               String
  sector             String
  csrThemes          String[]
  csrGeographies     String[]
  csrBudgetRemaining Decimal       @db.Decimal(14, 2)
  responseRate       Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches SponsorshipMatch[]

  @@map("sponsors")
}

// ===========================================================================
// Reports & problems
// ===========================================================================

enum ProblemCategory {
  water
  roads
  drainage
  streetlight
  waste
  bridge
  sanitation
  school
  health
}

enum Severity {
  critical
  high
  medium
  low
}

enum Stage {
  reported
  ai_processed
  validated
  prioritised
  sponsorship
  funded
  assigned
  implementation
  verification
  impact
}

enum ProblemStatus {
  pending_validation
  awaiting_sponsorship
  funding_required
  in_progress
  verification_pending
  resolved
  rejected
}

enum ReportChannel {
  voice
  text
  photo
  ivr
  field
  /// The public web intake form. Distinct from `text` because provenance is a
  /// thing a district will ask about: a report typed into a browser by someone
  /// who found the site is not the same signal as one a field worker collected.
  web
}

model CitizenReport {
  id          String        @id @default(uuid())
  problemId   String?
  problem     Problem?      @relation(fields: [problemId], references: [id])
  reporterId  String?
  reporter    User?         @relation(fields: [reporterId], references: [id])
  /// Display name captured at intake (kept even when reporterId is null — IVR,
  /// field-collected). Never crosses to industry.
  citizenName String
  channel     ReportChannel
  /// Verbatim citizen text, in their language. Never logged, never crosses.
  raw         String
  language    String
  villageId   String
  village     Village       @relation(fields: [villageId], references: [id])
  lat         Float
  lng         Float
  photos      Int           @default(0)

  /// What the intake pass made of `raw`, kept on the report itself.
  ///
  /// Clustering runs minutes later and must not re-derive this: intake may have
  /// had a model available, and re-reading with the keyword pass would silently
  /// throw that answer away. It also means a report's classification can be
  /// audited against the text it came from, which is the whole argument for
  /// letting a model near the pipeline at all.
  aiCategory ProblemCategory?
  aiSeverity Severity?
  aiTitle    String?
  aiSummary  String?
  aiKeywords String[]
  /// "groq" or "keywords" — which pass produced the reading above.
  aiSource   String?

  duplicateOfId String?
  duplicateOf   CitizenReport?  @relation("ReportDuplicates", fields: [duplicateOfId], references: [id])
  duplicates    CitizenReport[] @relation("ReportDuplicates")
  aiConfidence  Float

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([problemId])
  @@index([villageId])
  @@map("citizen_reports")
}

model Problem {
  id                String          @id @default(uuid())
  title             String
  category          ProblemCategory
  status            ProblemStatus   @default(pending_validation)
  severity          Severity        @default(medium)
  stage             Stage           @default(ai_processed)
  jurisdictionId    String
  jurisdiction      Jurisdiction    @relation(fields: [jurisdictionId], references: [id])
  reportCount       Int             @default(0)
  duplicateCount    Int             @default(0)
  /// Kept separate from reportCount on purpose — see ProblemVote.
  voteCount         Int             @default(0)
  affected          Int             @default(0)
  /// UN Sustainable Development Goal numbers, 1–17. The matching input that
  /// makes IndustryProfile.sdgPreferences mean something.
  sdgGoals          Int[]
  slaDueAt          DateTime?
  estimatedCost     Decimal         @default(0) @db.Decimal(14, 2)
  departmentId      String?
  department        Department?     @relation(fields: [departmentId], references: [id])
  assignedOfficerId String?
  assignedOfficer   Officer?        @relation("ProblemAssignedOfficer", fields: [assignedOfficerId], references: [userId])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  villages            ProblemVillage[]
  reports             CitizenReport[]
  ai                  ProblemAi?
  factors             ProblemFactors?
  adjustments         PriorityAdjustment[]
  sponsorship         Sponsorship?
  sponsorMatches      SponsorshipMatch[]
  funding             Funding?
  fundingCommits      FundingCommitment[]
  projects            Project[]
  evidence            Evidence?
  verificationRequest VerificationRequest?
  verifications       Verification[]
  rankingObjections   RankingObjection[]
  audit               AuditEntry[]
  clusters            ClusterProblem[]
  ledgerEntries       LedgerEntry[]
  allocations         Allocation[]
  mentorshipRequests  MentorshipRequest[]
  studentTeams        StudentTeam[]
  votes               ProblemVote[]
  solutionProposals   SolutionProposal[]
  hackathons          HackathonProblem[]
  challengeProfile    ChallengeProfile?

  @@index([status])
  @@index([jurisdictionId])
  @@index([category])
  @@index([departmentId])
  @@map("problems")
}

model ProblemVillage {
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  villageId String
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@id([problemId, villageId])
  @@map("problem_villages")
}

/// The structured reading the intake model produced. 1:1 with a problem.
model ProblemAi {
  problemId          String          @id
  problem            Problem         @relation(fields: [problemId], references: [id], onDelete: Cascade)
  category           ProblemCategory
  categoryConfidence Float
  severity           Severity
  durationDays       Int
  affected           Int
  similarReports     Int
  clusterLabel       String
  /// One representative citizen utterance, verbatim. Internal — never crosses.
  originalQuote      String
  originalLanguage   String
  /// [{ label, value }] — the structured interpretation lines.
  interpretation     Json
  routedDepartmentId String?
  routingReason      String
  /// { byOfficerId, departmentId, reason, at } when an officer overrode routing.
  routingOverridden  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("problem_ai")
}

/// The eight need signals, each normalised 0–100. 1:1 with a problem.
model ProblemFactors {
  problemId        String  @id
  problem          Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  populationImpact Float
  severity         Float
  deprivation      Float
  coverage         Float
  duration         Float
  recurrence       Float
  /// Volume of citizen reports — "I have this problem".
  repeatedDemand   Float
  /// Volume of citizen votes — "I agree this matters". A separate signal from
  /// repeatedDemand and weighted separately, because the two disagree: the
  /// most-reported problem in the register is rarely the most-voted one.
  citizenVotes     Float   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("problem_factors")
}

/// Named, bounded corrections applied after the weighted sum — each shown to
/// the officer with its reason so the score stays auditable.
model PriorityAdjustment {
  id        String  @id @default(uuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  label     String
  points    Float
  reason    String

  createdAt DateTime @default(now())

  @@index([problemId])
  @@map("priority_adjustments")
}

/// A weighting for the priority engine. The published set for a jurisdiction is
/// `published = true`; a null jurisdictionId is the state-wide default.
model PriorityWeightSet {
  id             String        @id @default(uuid())
  jurisdictionId String?
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id])
  published      Boolean       @default(false)
  /// { populationImpact, severity, deprivation, coverage, duration, recurrence, repeatedDemand }
  weights        Json
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([jurisdictionId, published])
  @@map("priority_weight_sets")
}

// ===========================================================================
// Clustering
// ===========================================================================

model Cluster {
  id               String          @id @default(uuid())
  code             String          @unique
  title            String
  category         ProblemCategory
  label            String
  reportCount      Int             @default(0)
  mergedDuplicates Int             @default(0)
  affected         Int             @default(0)
  centroidLat      Float
  centroidLng      Float
  radiusM          Float
  rank             Int?
  totalRanked      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problems      ClusterProblem[]
  ledgerEntries LedgerEntry[]
  allocations   Allocation[]

  @@map("clusters")
}

model ClusterProblem {
  clusterId String
  cluster   Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([clusterId, problemId])
  @@map("cluster_problems")
}

// ===========================================================================
// Sponsorship & funding
// ===========================================================================

enum SponsorshipStatus {
  not_eligible
  awaiting
  invited
  interested
  proposal
  approved
  declined
}

enum SponsorMatchStatus {
  matched
  invited
  interested
  proposal
  declined
  approved
}

enum FundingStatus {
  not_required
  pending
  recommended
  approved
  rejected
}

model Sponsorship {
  problemId         String            @id
  problem           Problem           @relation(fields: [problemId], references: [id], onDelete: Cascade)
  status            SponsorshipStatus @default(not_eligible)
  eligible          Boolean           @default(false)
  invitedAt         DateTime?
  responseDueAt     DateTime?
  approvedSponsorId String?
  approvedAmount    Decimal?          @db.Decimal(14, 2)
  failureReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  csrBenefit CsrBenefit?

  @@map("sponsorships")
}

model SponsorshipMatch {
  id             String             @id @default(uuid())
  problemId      String
  problem        Problem            @relation(fields: [problemId], references: [id], onDelete: Cascade)
  sponsorId      String
  sponsor        Sponsor            @relation(fields: [sponsorId], references: [id])
  score          Float
  reasons        String[]
  status         SponsorMatchStatus @default(matched)
  respondedAt    DateTime?
  proposalAmount Decimal?           @db.Decimal(14, 2)
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([problemId, sponsorId])
  @@index([problemId])
  @@map("sponsorship_matches")
}

model Funding {
  problemId                 String        @id
  problem                   Problem       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  status                    FundingStatus @default(not_required)
  required                  Decimal       @default(0) @db.Decimal(14, 2)
  source                    String?
  departmentBudgetAvailable Decimal       @default(0) @db.Decimal(14, 2)
  fundable                  Boolean       @default(false)
  approvedAt                DateTime?
  approvedById              String?
  approvedBy                User?         @relation("FundingApprovedBy", fields: [approvedById], references: [id])
  /// Display name captured at approval time (fixtures record a name, not an id).
  approvedByName            String?
  note                      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("funding")
}

enum CommitmentStatus {
  intent
  proposal_submitted
  awaiting_government
  committed
  disbursing
  closed
}

model FundingCommitment {
  id           String           @id @default(uuid())
  problemId    String
  problem      Problem          @relation(fields: [problemId], references: [id])
  sponsorOrgId String
  sponsorOrg   Organization     @relation(fields: [sponsorOrgId], references: [id])
  amount       Decimal          @db.Decimal(14, 2)
  status       CommitmentStatus @default(intent)
  alsoOffering String[]
  approvedAt   DateTime?
  approvedBy   String?
  note         String?
  /// [{ label, amount, releasedOn, released }]
  tranches     Json             @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([problemId])
  @@map("funding_commitments")
}

// ===========================================================================
// Public ledger
// ===========================================================================

enum LedgerStage {
  allocated
  committed
  disbursed
  verified
}

model LedgerEntry {
  id                 String      @id @default(uuid())
  problemId          String?
  problem            Problem?    @relation(fields: [problemId], references: [id])
  clusterId          String?
  cluster            Cluster?    @relation(fields: [clusterId], references: [id])
  title              String
  amount             Decimal     @db.Decimal(14, 2)
  currency           String      @default("INR")
  department         String
  fiscalYear         String
  stage              LedgerStage
  verifiedByCitizens Boolean     @default(false)
  at                 DateTime

  createdAt DateTime @default(now())

  @@index([fiscalYear])
  @@map("ledger_entries")
}

enum AllocationStatus {
  proposed
  approved
  released
}

model Allocation {
  id           String           @id @default(uuid())
  clusterId    String?
  cluster      Cluster?         @relation(fields: [clusterId], references: [id])
  problemId    String?
  problem      Problem?         @relation(fields: [problemId], references: [id])
  amount       Decimal          @db.Decimal(14, 2)
  approvedById String
  approvedBy   User             @relation("AllocationApprovedBy", fields: [approvedById], references: [id])
  status       AllocationStatus @default(proposed)
  approvedAt   DateTime?

  createdAt DateTime @default(now())

  @@map("allocations")
}

// ===========================================================================
// Delivery
// ===========================================================================

enum ProjectKind {
  gov
  industry
}

enum ProjectPhase {
  planning
  implementation
  testing
  completed
}

enum ProjectStage {
  discovery
  team_formed
  funded
  research
  prototype
  testing
  pilot
  deployment
  impact
}

model Project {
  id             String        @id @default(uuid())
  kind           ProjectKind
  problemId      String?
  problem        Problem?      @relation(fields: [problemId], references: [id])
  title          String
  phase          ProjectPhase  @default(planning)
  stage          ProjectStage?
  progress       Int           @default(0)
  budget         Decimal       @default(0) @db.Decimal(14, 2)
  spent          Decimal       @default(0) @db.Decimal(14, 2)
  contractor     String?
  officerId      String?
  universityId   String?
  teamId         String?
  team           StudentTeam?  @relation(fields: [teamId], references: [id])
  governmentBody String?
  /// UN Sustainable Development Goal numbers, 1–17. Usually inherited from the
  /// problem, but a project may address more than the problem it came from.
  sdgGoals       Int[]
  startedAt      DateTime?
  dueAt          DateTime?
  planDays       Int?
  dayOfPlan      Int?
  /// gov projects carry a simple [{ label, done, at? }] milestone list; the
  /// richer industry milestone lands as its own table in stage 7.
