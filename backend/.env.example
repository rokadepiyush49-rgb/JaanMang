# Jan Setu backend — configuration template.
#
# Copy to .env and fill in real values. .env is gitignored; never commit secrets.
# Every variable is validated at boot by src/config/env.schema.ts — a missing or
# malformed required value fails the process with a readable message rather than
# surfacing as a runtime error later.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call the API (the Flutter
# app is not a browser and needs no entry). Used for CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:3100
# public base URL the API is reachable at — only used to build absolute links
# in OpenAPI and email templates.
PUBLIC_API_URL=http://localhost:4000
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database  (Neon — https://neon.tech, free tier, no card)
# ---------------------------------------------------------------------------
# Pooled connection string for the app. For Neon use the "-pooler" host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jansetu?schema=public
# Direct (non-pooled) connection — required by `prisma migrate`.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/jansetu?schema=public

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# 32+ char random strings. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-000000000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# OTP: 6-digit codes, hashed at rest. In development the code is also logged so
# you can sign in without an SMS provider wired up.
OTP_TTL=5m
OTP_DEV_ECHO=true

# ---------------------------------------------------------------------------
# Object storage  (Cloudflare R2 — S3-compatible. Optional until stage 9.)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jansetu-dev
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Clustering  (tuning, not credentials — every one has a working default)
#
# The right values depend on the terrain: two reports 2 km apart are the same
# handpump in a dense panchayat and two different ones across a block. These
# defaults are tuned for Ranchi district. They stay here rather than in the
# root .env because they are not secrets and are not shared with the web app.
# ---------------------------------------------------------------------------
# Below this classification confidence a report stays its own problem rather
# than being guessed into a cluster. Raise it to split more, lower to merge more.
CLUSTER_CONFIDENCE_MIN=0.55
# How far apart two reports of the same thing can be filed.
CLUSTER_RADIUS_M=2000
# Minimum shared vocabulary (0-1) to call two reports the same problem.
CLUSTER_SIMILARITY_MIN=0.18
# Set false to stop the clustering cron — one-off imports, or debugging.
CLUSTER_CRON_ENABLED=true

# ---------------------------------------------------------------------------
# AI  (optional — the report-intake endpoint falls back to a keyword pass)
# ---------------------------------------------------------------------------
# Free key, no card: https://console.groq.com/keys  (already used by apps/web)
GROQ_API_KEY=
# Free key, no GCP billing: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Push  (optional until stage 9 — Firebase Cloud Messaging admin credentials)
# ---------------------------------------------------------------------------
FCM_SERVICE_ACCOUNT_JSON=
