  "info": {
    "title": "Jan Setu API",
    "description": "Generated — do not edit by hand. Run `npm run openapi:gen`.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "OtpRequestDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "pattern": "^\\+?[0-9]{8,15}$"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "login",
              "phone_verify"
            ],
            "default": "login"
          }
        },
        "required": [
          "phone"
        ]
      },
      "OtpVerifyDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "pattern": "^\\+?[0-9]{8,15}$"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "PasswordResetRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "PasswordResetDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "PublishWeightsDto": {
        "type": "object",
        "properties": {
          "weights": {
            "type": "object",
            "properties": {
              "populationImpact": {
                "type": "number",
                "minimum": 0,
                "exclusiveMinimum": false,
                "maximum": 100,
                "exclusiveMaximum": false
              },
              "severity": {
                "type": "number",
                "minimum": 0,
                "exclusiveMinimum": false,
                "maximum": 100,
                "exclusiveMaximum": false
              },
              "deprivation": {
                "type": "number",
                "minimum": 0,
                "exclusiveMinimum": false,
                "maximum": 100,
                "exclusiveMaximum": false
              },
              "coverage": {
                "type": "number",
                "minimum": 0,
                "exclusiveMinimum": false,
                "maximum": 100,
                "exclusiveMaximum": false
              },
              "duration": {
                "type": "number",
                "minimum": 0,
                "exclusiveMinimum": false,
                "maximum": 100,
                "exclusiveMaximum": false
              },
              "recurrence": {
                "type": "number",
                "minimum": 0,
                "exclusiveMinimum": false,
                "maximum": 100,
                "exclusiveMaximum": false
              },
              "repeatedDemand": {
                "type": "number",
                "minimum": 0,
                "exclusiveMinimum": false,
                "maximum": 100,
                "exclusiveMaximum": false
              }
            },
            "required": [
              "populationImpact",
              "severity",
              "deprivation",
              "coverage",
              "duration",
              "recurrence",
              "repeatedDemand"
            ]
          },
          "jurisdictionId": {
            "type": "string"
          }
        },
        "required": [
          "weights"
        ]
      },
      "RejectProblemDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1000
          }
        },
        "required": [
          "reason"
        ]
      },
      "RouteProblemDto": {
        "type": "object",
        "properties": {
          "departmentId": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1000
          }
        },
        "required": [
          "departmentId",
          "reason"
        ]
      }
    }
  }
}
