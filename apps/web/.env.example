# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# ---------------------------------------------------------------------------
# AI Project Council  (src/lib/council/)
# ---------------------------------------------------------------------------

# Required. Powers every council agent's spoken turn and the final verdict.
# Free key, no card: https://console.groq.com/keys
# Without it, /council/session answers 503 and tells you exactly this.
GROQ_API_KEY=

# Optional — the model that writes the verdict. Leave unset to use
# openai/gpt-oss-120b, which supports strict JSON-schema output and so gives
# the most reliable scoring; models without it fall back to plain JSON mode
# automatically. Groq retires model ids without notice and a retired id 404s
# on every call, so check https://api.groq.com/openai/v1/models before pinning.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional — the model for spoken debate turns only. These are ~18 of the ~19
# calls in a session and the easiest work in the app, so they default to a
# smaller model. Groq meters rate limits per model, which also keeps debate
# traffic off the bucket the verdict depends on.
# GROQ_DEBATE_MODEL=openai/gpt-oss-20b

# Optional — how long a session runs. Read by both the client and the server.
#   standard (default) diagnosis + challenge + refinement = 3 turns per agent
#   quick              drops the challenge round = 2 turns per agent
#   deep               two challenge rounds = 4 turns per agent
# A six-seat panel on `standard` is 18 turns. Use `quick` to fit a demo slot —
# at the cost of the disagreement round that makes the council worth watching.
# NEXT_PUBLIC_COUNCIL_PROFILE=standard
